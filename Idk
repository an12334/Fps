-- SIÊU HÀM TỐI ƯU HÓA HẾT CÔNG SUẤT (POTATO MODE VĨNH VIỄN)
local function MaxCapacityFix()
    -- 1. Ép Roblox Engine hạ cấu hình xuống mức thấp nhất hệ thống
    settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    
    -- 2. Triệt tiêu hoàn toàn Ánh sáng, Bóng đổ, Mặt trời, Mây mù
    Lighting.GlobalShadows = false
    Lighting.Brightness = 0
    Lighting.ClockTime = 12
    Lighting.FogEnd = 999999
    Lighting.FogStart = 999999
    
    for _, v in pairs(Lighting:GetChildren()) do
        if v:IsA("Sky") or v:IsA("Atmosphere") or v:IsA("Clouds") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("BloomEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("DepthOfFieldEffect") then
            v:Destroy()
        end
    end
    
    -- Tạo bầu trời trống rỗng màu xám (vừa đỡ chói mắt, vừa không tốn GPU render)
    local GraySky = Instance.new("Sky", Lighting)
    local grayId = "rbxassetid://924320031"
    GraySky.SkyboxBk = grayId GraySky.SkyboxDn = grayId GraySky.SkyboxFt = grayId
    GraySky.SkyboxLf = grayId GraySky.SkyboxRt = grayId GraySky.SkyboxUp = grayId

    -- 3. Đóng băng các chuyển động và chi tiết của Nước (Terrain)
    local terrain = Workspace:FindFirstChildOfClass("Terrain")
    if terrain then
        terrain.WaterWaveSize = 0
        terrain.WaterWaveSpeed = 0
        terrain.WaterReflectance = 0
        terrain.WaterTransparency = 1
        terrain.Decoration = false
    end

    -- 4. Hàm hủy diệt mọi vật thể gây nặng máy (Quét tận gốc)
    local function ClearLag(v)
        if v:IsA("BasePart") or v:IsA("MeshPart") or v:IsA("Part") then
            v.CastShadow = false
            v.Reflectance = 0
            v.Material = Enum.Material.SmoothPlastic -- Biến mọi cấu trúc thành nhựa trơn
            
            -- XÓA THÊM: Đá, Cỏ trang trí ngoài map để trống chỗ hoàn toàn
            local nameLower = v.Name:lower()
            if nameLower:find("tree") or nameLower:find("leaf") or nameLower:find("bush") or nameLower:find("grass") or nameLower:find("rock") then
                v:Destroy()
                return
            end
        end
        
        -- Hủy bỏ hoàn toàn hoa văn bám trên bề mặt (Decals/Textures)
        if v:IsA("Decal") or v:IsA("Texture") or v:IsA("SurfaceAppearance") then
            v:Destroy()
        -- Hủy diệt hiệu ứng hạt, khói, lửa, tia sáng từ chiêu thức của Boss/Quái/Player
        elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") or v:IsA("Beam") then
            v:Destroy()
        -- Tắt toàn bộ nguồn phát sáng cục bộ ngoài bản đồ
        elseif v:IsA("Light") or v:IsA("PointLight") or v:IsA("SpotLight") or v:IsA("SurfaceLight") then
            v:Destroy()
        end
    end

    -- Thực hiện đợt quét tổng lực đầu tiên
    for _, obj in pairs(Workspace:GetDescendants()) do
        ClearLag(obj)
    end
    
    -- KHÓA CỨNG: Đảo mới load ra hoặc chiêu thức vừa tung ra sẽ bị triệt hạ hiệu ứng lập tức
    Workspace.DescendantAdded:Connect(ClearLag)
    
    -- Xóa bớt texture trang phục 3D của người chơi khác để mượt tối đa khi tụ tập đông
    for _, pl in pairs(Players:GetPlayers()) do
        if pl ~= Players.LocalPlayer and pl.Character then
            for _, item in pairs(pl.Character:GetDescendants()) do
                if item:IsA("Shirt") or item:IsA("Pants") or item:IsA("Graphic") then
                    item:Destroy()
                end
            end
        end
    end
end

-- TẠO CÁC NÚT BẤM
local function CreateButton(text, pos, callback)
    local btn = Instance.new("TextButton", Frame)
    btn.Size = UDim2.new(0.9, 0, 0, 45)
    btn.Position = pos
    btn.BackgroundColor3 = Color3.fromRGB(120, 0, 0) -- Đỏ sẫm cảnh báo "Hết công suất"
    btn.Text = text
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 16
    btn.MouseButton1Click:Connect(callback)
end

