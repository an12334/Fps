-- Hàm hiệu ứng cầu vồng
local function MakeRainbow(obj, prop)
    spawn(function()
        while obj and obj.Parent do
            for i = 0, 1, 0.05 do
                obj[prop] = Color3.fromHSV(i, 1, 1)
                task.wait(0.1)
            end
        end
    end)
end

